<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 从底部弹出的动画 -->
    <style name="BottomToTopAnim" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/audio_bottomview_anim_enter</item>
        <item name="android:windowExitAnimation">@anim/audio_bottomview_anim_exit</item>
    </style>

    <!-- 从顶部滑出的动画 -->
    <style name="TopToBottomAnim" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/topview_anim_enter</item>
        <item name="android:windowExitAnimation">@anim/topview_anim_exit</item>
    </style>

    <style name="SUDOPGameInfoLabel">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#777777</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SUDOPGameInfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

</resources>